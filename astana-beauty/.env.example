# Скопируйте в .dev.vars локально. В Cloudflare задайте Secrets.
BOOKING_ENABLED=false
NOTIFICATIONS_ENABLED=false
# Telegram можно включить без WhatsApp; этот платный канал включается отдельно.
WHATSAPP_ENABLED=false
SITE_URL=http://localhost:5173
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CRON_SECRET=replace-with-another-random-secret-at-least-32-characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_REMINDER_RU=
TWILIO_REMINDER_KK=
TWILIO_CANCEL_RU=
TWILIO_CANCEL_KK=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
