# Скопируйте в .dev.vars локально. В Cloudflare задайте Secrets.
BOOKING_ENABLED=false
NOTIFICATIONS_ENABLED=false
SITE_URL=http://127.0.0.1:5173
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-characters
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
CRON_SECRET=replace-with-another-random-secret-at-least-32-characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_ID=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Автоматические WhatsApp-сообщения удалены. Twilio не требуется.
# Обычная кнопка WhatsApp настраивается в data/config.json.
